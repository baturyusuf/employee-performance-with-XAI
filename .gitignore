# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Noncanonical real-data stage-validation evidence is preserved locally under D5.
# Small publication summaries may be committed separately after the canonical freeze.
/reports/manuscript_final/stage_validation_hrdataset_20260713T175045Z_5af0262e83a3/
# Failed first canonical-build attempt is preserved locally for forensic recovery.
/reports/manuscript_final/canonical_v2_20260714T175804Z_4d08ca2/
# Failed post-benchmark canonical-build attempt is preserved locally for forensic recovery.
/reports/manuscript_final/canonical_v2_20260714T180533Z_770c8d0/
# Valid pre-migration candidate is preserved locally but cannot satisfy the later migration commit identity.
/reports/manuscript_final/canonical_v2_20260714T182539Z_35b121b/
# Failed migration-commit build is preserved locally; calibration publication was externally file-locked.
/reports/manuscript_final/canonical_v2_20260714T192934Z_0c2868b/
# Valid pre-pointer-validator candidate is preserved locally; its promoted pointer exposed the
# exact post-promotion worktree-validation defect repaired by the next clean checkpoint.
/reports/manuscript_final/canonical_v2_20260714T200409Z_0a70d66/
# Mutable local publication pointer; immutable packages and small receipts are tracked separately.
/reports/manuscript_final/latest/pointer.json
# Rejected canonical candidate is preserved locally; package scans found absolute metadata paths
# and one active leakage-safe taxonomy term after otherwise successful promotion validation.
/reports/manuscript_final/canonical_v2_20260714T210838Z_cd7b5e7/
# The validated canonical package remains local by default.  The frozen, aggregate
# publication-support subset is intentionally tracked so remote reviewers can read
# every final table, figure, source CSV, caption, manifest and claim boundary.
/reports/manuscript_final/canonical_v2_20260714T221501Z_483f96f/*
!/reports/manuscript_final/canonical_v2_20260714T221501Z_483f96f/core/
!/reports/manuscript_final/canonical_v2_20260714T221501Z_483f96f/supplementary/
/reports/manuscript_final/canonical_v2_20260714T221501Z_483f96f/core/*
!/reports/manuscript_final/canonical_v2_20260714T221501Z_483f96f/core/core_figures/
!/reports/manuscript_final/canonical_v2_20260714T221501Z_483f96f/core/core_tables/
!/reports/manuscript_final/canonical_v2_20260714T221501Z_483f96f/core/canonical_claim_boundaries.md
/reports/manuscript_final/canonical_v2_20260714T221501Z_483f96f/supplementary/*
!/reports/manuscript_final/canonical_v2_20260714T221501Z_483f96f/supplementary/supplementary_tables/
!/reports/manuscript_final/canonical_v2_20260714T221501Z_483f96f/supplementary/canonical_claim_boundaries.md

# User-provided HR data and row-level/fit-derived working data remain local.
# Dataset cards, schema mappings, README files, and directory placeholders stay tracked.
/data/raw/*
!/data/raw/.gitkeep
/data/external/*/raw.csv
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor  
#  Cursor is an AI-powered code editor.`.cursorignore` specifies files/directories to 
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore
