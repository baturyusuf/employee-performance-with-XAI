    },
    {
      "formulation_id": "raw_order_four_class",
      "role": "supplementary_mapping_sensitivity",
      "ordered_labels": [1, 2, 3, 4],
      "mapping": {"PIP": 1, "Needs Improvement": 2, "Fully Meets": 3, "Exceeds": 4, "Exceptional": 4},
      "rationale": "Preserves the dataset's ordered raw performance categories and isolates sensitivity to merging PIP with Needs Improvement; the unobserved Exceptional category shares the highest label without fabricating observations."
    }
  ],
