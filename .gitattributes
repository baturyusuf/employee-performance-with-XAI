# Auto detect text files and perform LF normalization
* text=auto

# Compact manuscript assets are hash-bound byte-for-byte.  Preserve their
# generated bytes on every platform and suppress whitespace diagnostics for
# JSON/Matplotlib line endings and SVG path data.
/manuscript/mdpi_information/assets/** -text
/manuscript/mdpi_information/assets/**/*.json whitespace=-trailing-space
/manuscript/mdpi_information/assets/**/*.svg whitespace=-trailing-space
