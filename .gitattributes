# Auto detect text files and perform LF normalization
* text=auto

# Compact manuscript assets are hash-bound byte-for-byte.  Preserve their
# generated bytes on every platform and suppress whitespace diagnostics for
# JSON/Matplotlib line endings and SVG path data.
/manuscript/mdpi_information/assets/** -text
/manuscript/mdpi_information/assets/**/*.json whitespace=-trailing-space
/manuscript/mdpi_information/assets/**/*.svg whitespace=-trailing-space

# Compact v3 evidence is also hash-bound byte-for-byte. Preserve source-run
# line endings so the tracked package remains identical to its manifest.
/reports/research_log/major_revision_v3/phase1b_ordinal_benchmark/** -text whitespace=-trailing-space
/reports/research_log/major_revision_v3/phase1c_repeated_nested_cv/** -text whitespace=-trailing-space
